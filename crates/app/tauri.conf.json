{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netfoo",
  "identifier": "io.netfoo.app",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "cargo build --quiet -p netfoo-helper && pnpm dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "netfoo",
        "width": 960,
        "height": 680,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
